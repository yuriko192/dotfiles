#!/usr/bin/env bash
# Turn a stowed $HOME symlink into a real file by moving it out of the package.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

require_home
require_fzf

usage() {
  cat <<EOF
Usage: $(basename "$0") <path> [path ...]

Unstow files or directories: remove \$HOME symlinks and move the real files
out of the package into \$HOME. Paths are relative to \$HOME
(leading ~/ or \$HOME/ ok). Directories expand to the files inside them.

If no path is given, opens a TUI to browse package trees
(Enter open dir / select file, . unstow dir, Tab multi-select).

Examples:
  $(basename "$0") .cursor/cli-config.json
  $(basename "$0") .config/ghostty
  $(basename "$0")          # TUI
EOF
}

# Find which package owns this $HOME-relative path; error if more than one matches.
# Return codes:
#   0  package file path printed to stdout
#   1  not found, or ambiguous across packages
find_package_file() {
  local relative_path="$1"
  local match=""
  local candidate

  for candidate in "$REPO_ROOT"/*/"$relative_path"; do
    if [[ -f "$candidate" ]]; then
      if [[ -n "$match" ]]; then
        echo "ambiguous package file for $relative_path:" >&2
        echo "  $match" >&2
        echo "  $candidate" >&2
        return 1
      fi
      match="$candidate"
    fi
  done

  if [[ -z "$match" ]]; then
    return 1
  fi

  printf '%s\n' "$match"
}

# Replace a $HOME symlink with the package file (moved out of the package).
unstow_file() {
  local relative_path
  relative_path="$(normalize_relative_path "$1")"
  local live_path="$HOME_DIR/$relative_path"
  local package_path

  if [[ -z "$relative_path" ]]; then
    echo "skip (empty path)" >&2
    return 0
  fi

  if ! package_path="$(find_package_file "$relative_path")"; then
    echo "skip (not in any package): $relative_path" >&2
    return 0
  fi

  if [[ -L "$live_path" ]]; then
    rm "$live_path"
    mkdir -p "$(dirname "$live_path")"
    mv "$package_path" "$live_path"
    echo "unstowed: $live_path (moved from ${package_path#"$REPO_ROOT"/})"
    return 0
  fi

  if [[ -f "$live_path" ]]; then
    echo "skip (already a real file): $live_path"
    return 0
  fi

  echo "skip (missing in \$HOME): $live_path" >&2
}

# Unstow every regular file under a package directory path.
unstow_directory() {
  local relative_path
  relative_path="$(normalize_relative_path "$1")"
  local package candidate file_path child_relative
  local found=0

  if [[ -z "$relative_path" ]]; then
    echo "skip (refusing to unstow package root)" >&2
    return 0
  fi

  for package in "$REPO_ROOT"/*/; do
    [[ -d "$package" ]] || continue
    candidate="${package%/}/$relative_path"
    [[ -d "$candidate" ]] || continue

    while IFS= read -r -d '' file_path; do
      # file_path is REPO_ROOT/pkg/rel/... — strip REPO_ROOT/pkg/
      child_relative="${file_path#${package%/}/}"
      unstow_file "$child_relative"
      found=1
    done < <(
      find "$candidate" -type f \
        ! -name '.DS_Store' \
        ! -name '.nvimlog' \
        -print0
    )
  done

  if [[ $found -eq 0 ]]; then
    echo "skip (no package files under directory): $relative_path" >&2
  fi
}

# Unstow a file or directory path.
unstow_path() {
  local relative_path
  relative_path="$(normalize_relative_path "$1")"
  local package candidate

  if [[ -z "$relative_path" ]]; then
    echo "skip (empty path)" >&2
    return 0
  fi

  for package in "$REPO_ROOT"/*/; do
    candidate="${package%/}/$relative_path"
    if [[ -d "$candidate" ]]; then
      unstow_directory "$relative_path"
      return 0
    fi
  done

  unstow_file "$relative_path"
}

# CLI paths, or open the TUI when none were given.
if [[ $# -gt 0 ]]; then
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
  fi
  files=("$@")
else
  ask_files_tui unstow
fi

for file_path in "${files[@]}"; do
  unstow_path "$file_path"
done

echo
echo "Done. Unstowed files were moved out of $REPO_ROOT."
